module Kernel.Model;

public enum Tier {
    Zero,
    Bonus = 3,
}

public struct Pair {
    public int x;
    public int y;

    public Pair(int left, int right) {
        x = left;
        y = right;
    }

    public int Sum() {
        return x + y;
    }
}

public class Counter {
    private int value;

    public Counter(int initial) {
        value = initial;
    }

    public int Add(int amount) {
        value = value + amount;
        return value;
    }

    public int Value {
        get { return value; }
    }
}

public Counter CreateCounter(int initial) {
    return new Counter(initial);
}

public long Widen(int value) {
    return value;
}

public double Scale(long value) {
    return value * 1.5;
}
