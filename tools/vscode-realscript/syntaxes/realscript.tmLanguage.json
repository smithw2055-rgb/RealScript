{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RealScript",
  "scopeName": "source.realscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.realscript", "match": "//.*$" },
        { "name": "comment.block.realscript", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.realscript",
          "match": "\\b(module|import|public|private|protected|static|abstract|virtual|override|sealed|readonly|const|class|struct|interface|enum|delegate|event|sequence|async|await|yield|wait_ticks|wait_seconds|wait_event|wait_until|wait_async|using|var|ref|out|is|as|if|else|while|for|foreach|in|do|switch|case|default|when|break|continue|return|throw|try|catch|finally|new|this|base|null|true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.realscript",
          "match": "\\b(void|bool|byte|sbyte|short|ushort|int|uint|long|ulong|float|double|char|string|handle|Fixed|Fixed16|Fixed64|Vec2|Vec3|Vec4|Quat|Transform3D|AABB|Ray|ResourceHandle|Resource|IDisposable|Awaitable|CancellationToken|CancellationTokenSource|List|Dictionary|HashSet|Queue|Stack|Nullable|Entity|Prefab)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.realscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.realscript", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.realscript", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    }
  }
}
