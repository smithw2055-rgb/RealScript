From 63bdf31e44e3758446f83eec3d1679ee6436893e Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Tue, 4 Aug 2026 07:49:17 +0000
Subject: [PATCH] Close cross-platform warnings and bytecode baselines

---
 src/aot_cpp/AotCpp.cpp               |   4 +-
 src/mir/MirLowerer.cpp               |   1 +
 src/runtime/Interpreter.cpp          |  13 ++-
 src/semantic/SemanticBinding.cpp     |   1 +
 src/semantic/SemanticExpressions.cpp |   2 +-
 src/syntax/SyntaxFacts.cpp           |   1 +
 tests/snapshots/phase2a.bytecode.txt |   2 +-
 tests/snapshots/phase2a.rsbc.hex.txt | 152 +++++++++++++--------------
 8 files changed, 92 insertions(+), 84 deletions(-)

diff --git a/src/aot_cpp/AotCpp.cpp b/src/aot_cpp/AotCpp.cpp
index 0a08aca..1f387a6 100644
--- a/src/aot_cpp/AotCpp.cpp
+++ b/src/aot_cpp/AotCpp.cpp
@@ -182,8 +182,8 @@ std::string binaryExpression(mir::Opcode opcode) {
 }
 
 bool isConversion(mir::Opcode opcode) {
-    return opcode >= mir::Opcode::ConvertNullToString &&
-        opcode <= mir::Opcode::ConvertLongToDouble ||
+    return (opcode >= mir::Opcode::ConvertNullToString &&
+            opcode <= mir::Opcode::ConvertLongToDouble) ||
         opcode == mir::Opcode::ConvertNumeric;
 }
 
diff --git a/src/mir/MirLowerer.cpp b/src/mir/MirLowerer.cpp
index 820ffec..b0ea795 100644
--- a/src/mir/MirLowerer.cpp
+++ b/src/mir/MirLowerer.cpp
@@ -1,5 +1,6 @@
 #include "realscript/mir/Mir.h"
 
+#include <algorithm>
 #include <stdexcept>
 
 namespace realscript::mir {
diff --git a/src/runtime/Interpreter.cpp b/src/runtime/Interpreter.cpp
index 0fdeaff..282accf 100644
--- a/src/runtime/Interpreter.cpp
+++ b/src/runtime/Interpreter.cpp
@@ -2161,6 +2161,7 @@ const char* errorCodeName(ErrorCode code) noexcept {
     case ErrorCode::ExecutionTerminated: return "execution-terminated";
     case ErrorCode::DeterminismViolation: return "determinism-violation";
     case ErrorCode::ReplayMismatch: return "replay-mismatch";
+    case ErrorCode::ScriptException: return "script-exception";
     }
     return "unknown";
 }
@@ -2256,14 +2257,18 @@ bool tryConvertNumeric(
         };
         switch (target) {
         case semantic::PrimitiveType::Byte:
-            if (!inRange(0, 255)) return false; break;
+            if (!inRange(0, 255)) return false;
+            break;
         case semantic::PrimitiveType::SByte:
-            if (!inRange(-128, 127)) return false; break;
+            if (!inRange(-128, 127)) return false;
+            break;
         case semantic::PrimitiveType::Short:
-            if (!inRange(-32768, 32767)) return false; break;
+            if (!inRange(-32768, 32767)) return false;
+            break;
         case semantic::PrimitiveType::UShort:
         case semantic::PrimitiveType::Char:
-            if (!inRange(0, 65535)) return false; break;
+            if (!inRange(0, 65535)) return false;
+            break;
         case semantic::PrimitiveType::Int:
             if (!inRange(
                     std::numeric_limits<std::int32_t>::min(),
diff --git a/src/semantic/SemanticBinding.cpp b/src/semantic/SemanticBinding.cpp
index 7d9144c..099f89f 100644
