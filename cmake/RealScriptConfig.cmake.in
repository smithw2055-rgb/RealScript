@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/RealScriptTargets.cmake")

set(RealScript_VERSION "@PROJECT_VERSION@")
set(RealScript_AOT_MODULE "${CMAKE_CURRENT_LIST_DIR}/RealScriptAot.cmake")
set(RealScript_HAS_DEBUG_SERVICES @REALSCRIPT_HAS_DEBUG_SERVICES_CMAKE@)
set(RealScript_HAS_TOOLING @REALSCRIPT_HAS_TOOLING_CMAKE@)
set(RealScript_HAS_EXTENSIBILITY @REALSCRIPT_HAS_EXTENSIBILITY_CMAKE@)
set(RealScript_HAS_GAME_SDK @REALSCRIPT_HAS_GAME_SDK_CMAKE@)

check_required_components(RealScript)
